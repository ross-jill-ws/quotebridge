{
  "apiVersion": 1,
  "id": "quotebridge.bollinger",
  "version": "1.0.0",
  "name": "Bollinger Bands",
  "description": "The simple moving average of the close, with bands a number of population standard deviations above and below it, as MetaTrader's Bands.",
  "license": "MIT",
  "entry": "calculate.js",
  "inputs": [
    {
      "id": "source",
      "label": "Close",
      "kind": "numeric",
      "alignment": "exact",
      "field": "close",
      "history": { "parameter": "period", "extra": 0 }
    }
  ],
  "parameters": [
    { "id": "period", "label": "Period", "type": "integer", "default": 20, "min": 1, "max": 500 },
    { "id": "deviations", "label": "Deviations", "type": "number", "default": 2, "min": 0.1, "max": 10 }
  ],
  "outputs": [
    {
      "id": "middle",
      "label": "Middle",
      "kind": "numeric",
      "render": "line",
      "placement": "overlay",
      "color": "#c9a227",
      "unit": { "input": "source" }
    },
    {
      "id": "upper",
      "label": "Upper",
      "kind": "numeric",
      "render": "line",
      "placement": "overlay",
      "color": "#6aa8ea",
      "unit": { "input": "source" }
    },
    {
      "id": "lower",
      "label": "Lower",
      "kind": "numeric",
      "render": "line",
      "placement": "overlay",
      "color": "#6aa8ea",
      "unit": { "input": "source" }
    }
  ]
}
