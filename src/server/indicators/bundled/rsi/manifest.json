{
  "apiVersion": 1,
  "id": "quotebridge.rsi",
  "version": "1.0.0",
  "name": "RSI",
  "description": "The Relative Strength Index of the close with Wilder's smoothing, as MetaTrader's RSI: 0 to 100, with levels at 30 and 70.",
  "license": "MIT",
  "entry": "calculate.js",
  "inputs": [
    {
      "id": "source",
      "label": "Close",
      "kind": "numeric",
      "alignment": "exact",
      "field": "close",
      "history": { "parameter": "period", "extra": 499 }
    }
  ],
  "parameters": [{ "id": "period", "label": "Period", "type": "integer", "default": 14, "min": 1, "max": 500 }],
  "outputs": [
    {
      "id": "rsi",
      "label": "RSI",
      "kind": "numeric",
      "render": "line",
      "placement": "pane",
      "color": "#c9a227",
      "unit": { "input": "source" }
    }
  ],
  "levels": [30, 70],
  "range": { "min": 0, "max": 100 }
}
